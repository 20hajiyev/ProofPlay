diff --git a/WickedEngine/shaders/outlinePS.hlsl b/WickedEngine/shaders/outlinePS.hlsl
index 2ef7dcc..52d9e75 100644
--- a/WickedEngine/shaders/outlinePS.hlsl
+++ b/WickedEngine/shaders/outlinePS.hlsl
@@ -4,6 +4,7 @@
 PUSHCONSTANT(postprocess, PostProcess);
 
 Texture2D<float> input : register(t0);
+Texture2D<float4> normals : register(t1); // racer P-003: visibility normal_roughness (valid when params0.z > 0)
 
 float4 main(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_TARGET
 {
@@ -64,5 +65,30 @@ float4 main(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_TARGET
 
 	float edge = dist > outlineThreshold ? 1 : 0;
 
+	// racer P-003: crease/panel ink lines. Where an outlined surface folds more sharply than the
+	// crease cosine between this pixel and a neighbour on the same surface, draw ink too. Depth
+	// alone only finds silhouettes; cel-shaded cars (PS2-era look) also ink their creases.
+	const float crease = postprocess.params0.z;
+	[branch]
+	if (crease > 0 && middle > 0 && edge == 0)
+	{
+		const int2 p = int2(uv * dim);
+		const int t = max(1, (int)round(outlineThickness * 0.75));
+		const half3 nc = decode_normal(normals.Load(int3(p, 0)).rg);
+		const int2 offsets[4] = { int2(t, 0), int2(-t, 0), int2(0, t), int2(0, -t) };
+		[unroll]
+		for (int i = 0; i < 4; ++i)
+		{
+			const int2 q = clamp(p + offsets[i], int2(0, 0), int2(dim) - 1);
+			const float d = input.Load(int3(q, 0));
+			if (d > 0 && abs(d - middle) < middle * 0.05)
+			{
+				const half3 nq = decode_normal(normals.Load(int3(q, 0)).rg);
+				if (dot(nc, nq) < crease)
+					edge = 1;
+			}
+		}
+	}
+
 	return float4(outlineColor.rgb, outlineColor.a * edge);
 }
